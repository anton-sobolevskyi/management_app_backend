{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "../..",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "maxWorkers": 1,
  "globalSetup": "<rootDir>/test/config/e2e.global-setup.ts",
  "globalTeardown": "<rootDir>/test/config/e2e.global-teardown.ts",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "moduleNameMapper": {
    "^(\\.{1,2}/.*)\\.js$": "$1"
  },
  "setupFiles": ["<rootDir>/test/helpers/docker-env.ts"],
  "setupFilesAfterEnv": ["<rootDir>/test/config/e2e.setup.ts"]
}
